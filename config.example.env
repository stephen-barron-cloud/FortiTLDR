# FortiTLDR settings.
# Copy this file to config.env and edit it:   cp config.example.env config.env
# config.env is listed in .gitignore, so your email addresses never get committed.
# Re-run `sudo ./install.sh` after changing anything here.

# Address the digest is sent FROM (must be an address on your mail account)
FORTITLDR_FROM=you@yourdomain.com

# Address the digest is sent TO
FORTITLDR_TO=you@yourdomain.com

# SMTP server. These defaults are for Proton Mail (needs a paid plan with a custom
# domain, and an SMTP token from Settings > IMAP/SMTP > SMTP tokens).
#   Gmail:    smtp.gmail.com          587  (use an App Password)
#   Fastmail: smtp.fastmail.com       587
#   Outlook:  smtp-mail.outlook.com   587
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587

# Tag at the start of every email subject, for mail filters and labels
SUBJECT_PREFIX=[FortiTLDR]

# When to run (systemd OnCalendar format). Examples:
#   "*-*-* 07:00 America/Chicago"      every day at 7am Central
#   "Mon..Fri 07:00 America/Chicago"   weekdays only
SCHEDULE="*-*-* 07:00 America/Chicago"
